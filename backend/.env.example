# Smart Blood Emergency Network — Backend Environment Configuration
# Copy this file to .env or set environment variables before launching backend.

# ------------------------------------------------------------
# Database Configuration (MariaDB / MySQL)
# ------------------------------------------------------------
# Created by database/setup-database.ps1 (defaults shown).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=SBN
DB_USERNAME=sben
DB_PASSWORD=sben

# ------------------------------------------------------------
# Security Configuration
# ------------------------------------------------------------
JWT_SECRET=c21hcnQtYmxvb2QtZW1lcmdlbmN5LW5ldHdvcmstZGV2LXNlY3JldC1rZXktMjAyNi1jaGFuZ2VtZQ==

# ------------------------------------------------------------
# Email (SMTP)
# MAIL_ENABLED=true sends real email; false logs emails (and OTPs) to the console.
# Gmail: MAIL_PASSWORD must be a 16-character Google *app password*
# (Google Account > Security > 2-Step Verification > App passwords),
# never the account password. MAIL_FROM must be the same Gmail address.
# Any other SMTP provider works by changing MAIL_HOST / MAIL_PORT.
# ------------------------------------------------------------
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=Smart Blood Emergency Network <your-address@gmail.com>
# Public URL of the web app, used for links in emails.
FRONTEND_URL=http://localhost:5173

# Optional delivery tuning (defaults shown)
# MAIL_SUPPRESSED_DOMAINS=example.com,example.org,example.net,example.test,sben.com
# MAIL_MAX_PER_MINUTE=20
# MAIL_MAX_PER_DAY=450

# ------------------------------------------------------------
# Administrators
# Comma-separated real addresses, created as ADMIN at startup if missing.
# Each sets a password with "Forgot password" (code goes to that inbox).
# ------------------------------------------------------------
ADMIN_EMAILS=
